{
  "name": "mathquill",
  "description": "Easily type math in your webapp",
  "version": "0.11.0",
  "license": "MPL-2.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sam-Strand/mathquill.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "development": "./src/vue/index.ts",
      "default": "./dist/vue.js"
    },
    "./mathquill.css": {
      "development": "./src/styles/main.scss",
      "default": "./dist/mathquill.css"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/language-core": "^3.3.13",
    "sass": "^1.106.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "hjson": "workspace:*",
    "vite-plugin-dts": "^5.1.2"
  },
  "peerDependencies": {
    "vue": "^3.5.44"
  }
}
