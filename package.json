{
  "name": "mathquill",
  "description": "Easily type math in your webapp",
  "version": "0.11.0",
  "license": "MPL-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mathquill/mathquill.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/mathquill.js",
      "types": "./dist/index.d.ts"
    },
    "./mathquill.css": {
      "development": "./src/styles/main.scss",
      "import": "./dist/mathquill.css"
    },
    "./fonts/*": {
      "development": "./src/fonts/*",
      "import": "./src/fonts/*"
    }
  },
  "devDependencies": {
    "@types/jquery": "^4.0.1",
    "@types/mocha": "^5.2.7",
    "dependency-cruiser": "^18.1.0",
    "lint-staged": "^12.3.1",
    "mocha": ">=2.4.1",
    "prettier": "^2.5.1",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "uglify-js": "2.x",
    "vite": "^8.1.0",
    "vite-plugin-dts": "^5.0.2"
  }
}
