# sets.hjson
{
  kind: binary                     # по умолчанию для всего файла
  symbols: {
    subseteq: { html: '⊆', aliases: ['sube', 'subeq', 'subsete'] }   # latex = "\subseteq "
    in:       { html: ∈, aliases: [isin] }
    nsubset:  { html: ⊄, latex: \not\subset, aliases: [notsub, notsubset] }
    cap:      ∩, aliases: [intersect, intersection] }
    ominus:   ⊖                    # краткая форма: только html, без алиасов
  }
}

